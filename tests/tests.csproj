<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Tau.Tests</RootNamespace>
    <AssemblyName>tau-tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\tau-cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    テストは tau を子プロセスとして起動する。tau-cli.csproj は自己完結 +
    単一ファイル配布なので、参照しただけでは `dotnet tau.dll` で動かない。
    フレームワーク依存の DLL を、テスト実行前にここへ用意しておく。
    (テスト実行中にビルドすると、並列実行するテストと競合する)
  -->
  <PropertyGroup>
    <TauTestFxDir>$(MSBuildThisFileDirectory)tau-fx\bin\</TauTestFxDir>
  </PropertyGroup>

  <Target Name="BuildTauForTests" BeforeTargets="VSTest">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\tau-cli.csproj"
             Targets="Build"
             Properties="Configuration=Release;PublishSingleFile=false;SelfContained=false;OutputPath=$(TauTestFxDir)" />
  </Target>

</Project>
