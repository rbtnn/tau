<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Tau.Tests</RootNamespace>
    <AssemblyName>tau-tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!--
      tau-cli.csproj は自己完結 + 単一ファイル配布なので、そのまま参照すると
      restore が RID 付きになり "Assets file ... doesn't have a target for
      net10.0/<rid>" で失敗する。テストからはフレームワーク依存で使う。
    -->
    <ProjectReference Include="..\tau-cli.csproj">
      <AdditionalProperties>SelfContained=false;PublishSingleFile=false;RuntimeIdentifier=;RuntimeIdentifiers=</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    テストは tau を子プロセスとして起動する。tau-cli.csproj は自己完結 +
    単一ファイル配布なので、参照しただけでは `dotnet tau.dll` で動かない。
    フレームワーク依存の DLL を、テスト実行前にここへ用意しておく。
    (テスト実行中にビルドすると、並列実行するテストと競合する)
  -->
  <PropertyGroup>
    <TauTestFxDir>$(MSBuildThisFileDirectory)tau-fx\bin</TauTestFxDir>
    <!-- read_document が呼ぶ補助ツール(pdf2text など)の置き場所 -->
    <TauHelpersDir>$(MSBuildThisFileDirectory)tau-fx\helpers</TauHelpersDir>
  </PropertyGroup>

  <Target Name="BuildTauForTests" BeforeTargets="PrepareForBuild;Build">
    <!--
      補助プロジェクトは tests の restore 対象外なので、MSBuild タスクでは
      RID 付きの assets が無く失敗する。dotnet build を別プロセスで呼ぶ。
    -->
    <Exec Command="dotnet build &quot;$(MSBuildThisFileDirectory)..\tau-cli.csproj&quot; -c Release -p:PublishSingleFile=false -p:SelfContained=false --nologo -v quiet -o &quot;$(TauTestFxDir)&quot;" />
    <Exec Command="dotnet build &quot;$(MSBuildThisFileDirectory)..\src\pdf2text\pdf2text.csproj&quot; -c Release -p:PublishSingleFile=false -p:SelfContained=false --nologo -v quiet -o &quot;$(TauHelpersDir)&quot;" />
    <Exec Command="dotnet build &quot;$(MSBuildThisFileDirectory)..\src\word2text\word2text.csproj&quot; -c Release -p:PublishSingleFile=false -p:SelfContained=false --nologo -v quiet -o &quot;$(TauHelpersDir)&quot;" />
    <Exec Command="dotnet build &quot;$(MSBuildThisFileDirectory)..\src\excel2text\excel2text.csproj&quot; -c Release -p:PublishSingleFile=false -p:SelfContained=false --nologo -v quiet -o &quot;$(TauHelpersDir)&quot;" />
  </Target>

</Project>
