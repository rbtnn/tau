<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>tau</AssemblyName>
    <RootNamespace>Tau</RootNamespace>

    <!-- C# の言語バージョンは既定 (.NET 10 なら C# 14) を使う -->
    <LangVersion>latest</LangVersion>

    <!-- ソースは src/ 配下 -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>

    <!-- カルチャ非依存で動かす(ICU の無い環境でも起動できる) -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- 単一ファイルで配布する -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>

    <!--
      RuntimeIdentifiers は publish するときだけ指定する(build.bat / CI)。
      既定で入れておくと、テストが ProjectReference で参照したときの
      restore が RID 付きになり、"Assets file ... doesn't have a target for
      net10.0/linux-musl-x64" で失敗する。
    -->

    <!-- 圧縮してサイズを抑える -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- バージョン情報 -->
    <Version>1.0.0</Version>
    <Authors>rbtnn</Authors>
    <Description>tau-cli - a console AI agent</Description>

    <!-- 警告をエラーにしない(移行中は警告を許容する) -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0162;CS0219</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- src/pdf2text/ などは別の exe なので除外する -->
    <Compile Include="src/**/*.cs"
             Exclude="src/pdf2text/**/*.cs;src/word2text/**/*.cs;src/excel2text/**/*.cs" />
    <!-- web 画面を実行ファイルに埋め込む(単一ファイル配布のため) -->
    <EmbeddedResource Include="src/www/index.html" />
  </ItemGroup>

  <!-- テストから内部クラス(Json など)を参照できるようにする -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>tau-tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
